# ---- Data ----
# Path to the Online Retail II file (.xlsx from UCI or a .csv export)
RAW_DATA_PATH=data/online_retail_II.xlsx
# Optional: only analyse one country, e.g. United Kingdom (empty = all)
COUNTRY=
# Number of best-selling products to forecast
TOP_N_PRODUCTS=300

# ---- Chat AI (any OpenAI-compatible API) ----
# Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.1-8b-instant
# Gemini:             LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
# OpenAI:             LLM_BASE_URL=https://api.openai.com/v1             LLM_MODEL=gpt-4o-mini
# Ollama (local):     LLM_PROVIDER=ollama  LLM_BASE_URL=http://localhost:11434  LLM_MODEL=llama3.1
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# ---- Frontend ----
# Leave empty during local development (Vite proxies /api to localhost:8000)
VITE_API_BASE=
